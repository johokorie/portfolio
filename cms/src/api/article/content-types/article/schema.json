{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": { "singularName": "article", "pluralName": "articles", "displayName": "Article", "description": "Journal posts for John’s portfolio" },
  "options": { "draftAndPublish": true },
  "attributes": {
    "title": { "type": "string", "required": true, "maxLength": 200 },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "excerpt": { "type": "text", "required": true, "maxLength": 500 },
    "content": { "type": "blocks", "required": true },
    "category": { "type": "string", "default": "Development", "maxLength": 80 },
    "cover": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "coverAlt": { "type": "string", "maxLength": 200 },
    "featured": { "type": "boolean", "default": false }
  }
}
